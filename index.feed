512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-4\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003ecp themes/even/exampleSite/config.toml hugo.toml\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003ch2 id=\"4创建一篇blog\" class=\"headerLink\"\u003e\n    \u003ca href=\"#4%e5%88%9b%e5%bb%ba%e4%b8%80%e7%af%87blog\" class=\"header-mark\"\u003e\u003c/a\u003e4 4.创建一篇blog\u003c/h2\u003e\u003cp\u003e当配置好主题之后，就可以创建自己的blog了。\n使用\u003ccode\u003ehugo new content content/post/my-first-post.md\u003c/code\u003e 即可创建一篇blog。\n可以看到当执行完该命令后，在 \u003ccode\u003econtent/post/\u003c/code\u003e 下面会出现一个新的md文件。\n\u003cimg class=\"tw-inline\" loading=\"lazy\" src='/b6760e2f47eed1c8a962e475f69adc92_6518912847253113034.png' srcset=\"/b6760e2f47eed1c8a962e475f69adc92_6518912847253113034_hu_c908f4a048ec6bfd.webp 800w, /b6760e2f47eed1c8a962e475f69adc92_6518912847253113034_hu_7092bcbf99a0ee4d.webp 1200w, /b6760e2f47eed1c8a962e475f69adc92_6518912847253113034_hu_2b1bb50e77a786c7.webp 1600w\"  alt=\"my-first-blog\" height=\"388\" width=\"1964\"\u003e\u003c/p\u003e\n\u003ch2 id=\"5运行hugo\" class=\"headerLink\"\u003e\n    \u003ca href=\"#5%e8%bf%90%e8%a1%8chugo\" class=\"header-mark\"\u003e\u003c/a\u003e5 5.运行hugo\u003c/h2\u003e\u003cp\u003e当前面的配置好之后，就可以使用 \u003ccode\u003ehugo server\u003c/code\u003e 来启动一个hugo server。\n\u003cimg class=\"tw-inline\" loading=\"lazy\" src='/69da7f70c3795f266a83207d186d0ad4_9992074773452968849.png' srcset=\"/69da7f70c3795f266a83207d186d0ad4_9992074773452968849_hu_d9462c556b9f2119.webp 800w, /69da7f70c3795f266a83207d186d0ad4_9992074773452968849_hu_15c617f96a6621e3.webp 1200w, /69da7f70c3795f266a83207d186d0ad4_9992074773452968849_hu_9bc46078d9bbf8d2.webp 1600w\"   height=\"940\" width=\"2668\"\u003e\n点击链接，即可访问blog网站的地址\n\u003cimg class=\"tw-inline\" loading=\"lazy\" src='/10ebbce59ca6637b1b44c8d884c471bd_12237597648526076018.png' srcset=\"/10ebbce59ca6637b1b44c8d884c471bd_12237597648526076018_hu_1f1bf16699b99098.webp 800w, /10ebbce59ca6637b1b44c8d884c471bd_12237597648526076018_hu_2096cbff401a9792.webp 1200w, /10ebbce59ca6637b1b44c8d884c471bd_12237597648526076018_hu_165078f3ac1361a6.webp 1600w\"   height=\"1484\" width=\"2364\"\u003e\n此时会发现，之前创建的那篇blog并没有在里面显示，原因是一开始创建的blog是\u003ccode\u003edraft\u003c/code\u003e,在\u003ccode\u003ehugo server\u003c/code\u003e 模式下并不会显示draft的blog。\n如果需要显示，则需要使用\u003ccode\u003ehugo server -D\u003c/code\u003e。\n\u003cimg class=\"tw-inline\" loading=\"lazy\" src='/72c092d59ad8143fa61188eac94ace32_2161862008488115701.png' srcset=\"/72c092d59ad8143fa61188eac94ace32_2161862008488115701_hu_71eb6cc2b9e896c3.webp 800w, /72c092d59ad8143fa61188eac94ace32_2161862008488115701_hu_bddacba46e149443.webp 1200w, /72c092d59ad8143fa61188eac94ace32_2161862008488115701_hu_e32d99c8d313790b.webp 1600w\"   height=\"1052\" width=\"3528\"\u003e\u003c/p\u003e\n\u003cp\u003e以上就可以完成了blog网站的搭建了。\u003c/p\u003e\n\u003ch1 id=\"参考链接\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83%e9%93%be%e6%8e%a5\" class=\"header-mark\"\u003e\u003c/a\u003e参考链接\u003c/h1\u003e\u003col\u003e\n\u003cli\u003e\u003ca href=\"https://gohugo.io/getting-started/quick-start/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://gohugo.io/getting-started/quick-start/\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://github.com/olOwOlo/hugo-theme-even\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://github.com/olOwOlo/hugo-theme-even\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://medium.com/@magstherdev/hugo-in-10-minutes-2dc4ac70ee11\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://medium.com/@magstherdev/hugo-in-10-minutes-2dc4ac70ee11\u003c/a\u003e\u003c/li\u003e\n\u003c/ol\u003e\n",
        "language": "en"
    }
    ]
}
